# =============================================================================
# Gramoz Web (Next.js) — Environment Configuration
# =============================================================================

# Internal Backend API URL (Server-side only — NEVER expose via NEXT_PUBLIC_)
# Used by Next.js rewrites and SSR to communicate with the NestJS backend.
# In local dev: http://localhost:5000
# In Docker Compose: http://backend:5000 (service name in docker-compose.yml)
# In production: http://backend:5000 or internal private IP/DNS
INTERNAL_API_URL=http://localhost:5000

# Browser API Configuration (Public relative path or reverse proxy endpoint)
NEXT_PUBLIC_API_URL=/api/v1

# Direct Backend Server URL (Optional: used for direct OAuth redirects or multipart bypass)
# Leave empty if frontend and backend share an ingress / reverse proxy
NEXT_PUBLIC_SERVER_URL=http://localhost:5000

# Media / CDN Storage URL (Cloudflare R2 or CDN public domain)
R2_PUBLIC_URL=https://media.gramoz.com
MEDIA_URL=https://media.gramoz.com

# App Configuration
NEXT_PUBLIC_APP_NAME=Gramoz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Edge Proxy Authentication Secret (Server-side only — NEVER expose via NEXT_PUBLIC_)
AUTH_JWT_SECRET=your-32-character-or-longer-production-secret-key-here
